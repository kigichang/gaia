{
  "name": "gaia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "國/高中地理課程等高線地圖教學網站",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "test:order": "node scripts/test-layer-order.mjs",
    "build": "npm run validate && npm run test:order && npm run typecheck && vite build && node scripts/postbuild.mjs",
    "build:debug": "vite build --mode debug && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:climate": "node scripts/build-climate.mjs",
    "build:species": "node scripts/build-species.mjs",
    "build:geodata": "node scripts/build-geodata.mjs"
  },
  "dependencies": {
    "maplibre-contour": "0.1.0",
    "maplibre-gl": "6.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
